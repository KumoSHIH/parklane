doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../assets/css/index.css")

  body.index(data-page="home")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        .stable-view
          .banner
            .banner-wrap
              .banner-photo
                figure.photo-logo1
                  img(src="../assets/img/logo-color.png", alt="")
                figure.photo-logo2
                  img(src="../assets/img/logo01.png", alt="")
              // 5/8 修改
              .banner-scroll
                .text-wrap Scroll
                .line
          // 5/8 修改 刪除 section 這一層
          .common-list.common-content
            .select-list
              // 4/26 修改 有新增分類 & 順序有改
              ul
                each val,index in select
                  li(class= (index === 0 ? 'all active' : ''))= val
            // 後端callback
            // 回到內容最上方 JS: _list.anchorContent();
            .content-wrap
              .scrollbar-inner
                ul
                  each val in news
                    li 
                      a(href="javascript:;")
                        .photo
                          .photo-wrap 
                            img(src= val.photo, alt="")
                        .text 
                          h2= val.title
                          p= val.text
    
      // footer
      include ../layouts/_footer.pug
  //引入的script
  include ../layouts/_script.pug
