doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../assets/css/nearby.css")

  body.nearby(data-page="nearby")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        .swiper.common-content 
          .swiper-container 
            .swiper-wrapper
              each val in swiper
                .swiper-slide
                  a.slide-wrap(href="./detail.html")
                    .photo 
                      .photo-wrap
                        img(src= val.photo, alt="")
                    .bottom
                      .text
                        h2= val.title
                        p= val.text
                        ul
                          each tag in val.tag
                            li= tag
                      .time
                        div
                          // 5/14 修改 刪除 span 後面的空格
                          span= val.time
                          span min
                        // 6/7 修改
                        p WALK
          .swiper-button-prev
          .swiper-button-next
      // footer
      include ../layouts/_footer.pug

  //引入的script
  include ../layouts/_script.pug
